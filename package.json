{
  "name": "plasticwan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "plasticwan": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm run cli:check && pnpm --filter plasticwan-admin-next run check && pnpm run docs:check",
    "cli:check": "tsc -p packages/cli/tsconfig.json --noEmit",
    "cli:build": "tsc -p packages/cli/tsconfig.json",
    "test": "vitest run",
    "start": "node src/cli.ts serve",
    "dev:seed": "node scripts/seed-dev-data.ts",
    "admin:dev": "pnpm --filter plasticwan-admin-next run dev",
    "admin:build": "pnpm --filter plasticwan-admin-next run build",
    "admin:test:e2e": "pnpm --filter plasticwan-admin-next run test:e2e",
    "docs:dev": "pnpm --filter plasticwan-docs run dev",
    "docs:build": "pnpm --filter plasticwan-docs run build",
    "docs:preview": "pnpm --filter plasticwan-docs run preview",
    "docs:check": "pnpm --filter plasticwan-docs run check",
    "docs:verify": "node scripts/docs-verify.ts",
    "manual:prepare": "node scripts/manual-prepare.ts",
    "postinstall": "node scripts/skills-sync.ts --postinstall",
    "skills:sync": "node scripts/skills-sync.ts",
    "lint": "biome lint . && biome format .",
    "lint:fix": "biome lint --write --unsafe . && biome format --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@hono/node-server": "^2.1.4",
    "@inquirer/prompts": "^8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "^2.2.2",
    "@plasticwan/image-service": "workspace:^",
    "@simplewebauthn/server": "14.0.3",
    "better-sqlite3": "^13.0.3",
    "defuddle": "0.19.5",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "grammy": "1.46.0",
    "hono": "^4.13.13",
    "jsonc-parser": "^3.3.1",
    "sharp": "0.35.5",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "skills": "1.7.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "zod": "4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "skills": [
    {
      "source": "alibaba/open-code-review",
      "ref": "v1.13.2",
      "skills": [
        "open-code-review"
      ]
    }
  ]
}
